# Correct MIME types for modules/wasm
AddType application/javascript .js .mjs .jsx
AddType application/wasm       .wasm
AddType application/json       .json

# Dev-friendly caching (you can relax later)
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</IfModule>

# Single Page App fallback (only if you’re using client-side routing)
RewriteEngine On
RewriteBase /NarutoGame/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
